// LEGACY_ALERT_OFF alertcondition(lateSellExhaustion or antiBottomSell, "IMPULXOR V39.2 BLOQUEO SELL AGOTADO", "SELL bloqueado: posible piso/agota/no perseguir")


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// IMPULXOR V47.2 - ALERTAS TELEGRAM BUY/SELL/PRE LIMPIAS
// NO cambia visual ni lógica. Solo reemplaza las alertas antiguas.
// Crear alerta en TradingView con: Any alert() function call
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

impV46_dirTxt = masterDir == 1 ? "BUY" : masterDir == -1 ? "SELL" : "WAIT"
impV46_scoreFinal = masterDir == 1 ? buyScore : masterDir == -1 ? sellScore : math.max(buyScore, sellScore)

impV46_hasEntry = not na(entryLine)
impV46_hasSL    = not na(slLine)
impV46_hasTP1   = not na(tp1Line)
impV46_hasTP2   = not na(tp2Line)
impV46_hasDir   = masterDir == 1 or masterDir == -1

impV46_validData = impV46_hasEntry and impV46_hasSL and impV46_hasTP1 and impV46_hasTP2 and impV46_hasDir and not conflict

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// V47.1 ALERT ENGINE
// Más sensible para no quedarse mudo en Telegram.
// NO toca paneles, cajas, colores ni visual.
// Separa entrada confirmada y pre-alerta operable.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
impV47_buyConfirmed = strongEntry or softEntry or sniperBuy or reEntryBuy or rareOpportunityBuy or v45EntryBuy or triggerBuyV48 or ictBuyTrigger or fractalTriggerBuy
impV47_sellConfirmed = strongEntry or softEntry or sniperSell or reEntrySell or rareOpportunitySell or v45EntrySell or triggerSellV48 or ictSellTrigger or fractalTriggerSell

impV47_buyEarly = masterDir == 1 and validNoFomo and not closeNow and not lateralWait and scoreShown >= 58 and (preBuyArming or smartBuyAllowed or macroEntryBuy or buyContinuation or absorbBuy or seqAbsorbBuy or pocDefendedBuy) and not lateBuyExhaustion and not antiTopBuy
impV47_sellEarly = masterDir == -1 and validNoFomo and not closeNow and not lateralWait and scoreShown >= 58 and (preSellArming or smartSellAllowed or macroEntrySell or sellContinuation or absorbSell or seqAbsorbSell or pocDefendedSell) and not lateSellExhaustion and not antiBottomSell

impV47_buyHasSpace = not buyWaitContinuation or microBosBuy or spaceOperationalPct >= 30 or macroEntryBuy
impV47_sellHasSpace = not sellWaitContinuation or microBosSell or spaceOperationalPct >= 30 or macroEntrySell

impV46_buySignal = impV46_validData and masterDir == 1 and not closeNow and not lateralWait and impV47_buyHasSpace and impV47_buyConfirmed
impV46_sellSignal = impV46_validData and masterDir == -1 and not closeNow and not lateralWait and impV47_sellHasSpace and impV47_sellConfirmed

impV47_buyPreAlert = impV46_validData and masterDir == 1 and not closeNow and not lateralWait and not impV47_buyConfirmed and impV47_buyEarly
impV47_sellPreAlert = impV46_validData and masterDir == -1 and not closeNow and not lateralWait and not impV47_sellConfirmed and impV47_sellEarly

impV46_price(_v) =>
    not na(_v) ? str.tostring(_v, format.mintick) : str.tostring(close, format.mintick)

impV46_clean(_s) =>
    str.length(_s) > 0 ? _s : "-"

impV46_msg(_side) =>
    string msg = "{"
    msg += "\"source\":\"IMPULXOR_V50_1_PREV_DAY_FRACTAL_PRO\","
    msg += "\"ticker\":\"" + syminfo.ticker + "\","
    msg += "\"symbol\":\"" + syminfo.tickerid + "\","
    msg += "\"tf\":\"" + timeframe.period + "\","
    msg += "\"signal\":\"" + _side + "\","
    msg += "\"type\":\"" + _side + "\","
    msg += "\"direction\":\"" + _side + "\","
    msg += "\"side\":\"" + _side + "\","
    msg += "\"action\":\"" + _side + "\","
    msg += "\"order\":\"" + _side + "\","
    msg += "\"order_type\":\"" + _side + "\","
    msg += "\"orden\":\"" + _side + "\","
    msg += "\"event\":\"ENTRY_" + _side + "\","
    msg += "\"price\":\"" + impV46_price(entryLine) + "\","
    msg += "\"precio\":\"" + impV46_price(entryLine) + "\","
    msg += "\"entry\":\"" + impV46_price(entryLine) + "\","
    msg += "\"entry_price\":\"" + impV46_price(entryLine) + "\","
    msg += "\"sl\":\"" + impV46_price(slLine) + "\","
    msg += "\"stoploss\":\"" + impV46_price(slLine) + "\","
    msg += "\"stop_loss\":\"" + impV46_price(slLine) + "\","
    msg += "\"tp1\":\"" + impV46_price(tp1Line) + "\","
    msg += "\"take_profit_1\":\"" + impV46_price(tp1Line) + "\","
    msg += "\"tp2\":\"" + impV46_price(tp2Line) + "\","
    msg += "\"take_profit_2\":\"" + impV46_price(tp2Line) + "\","
    msg += "\"score\":\"" + str.tostring(math.round(impV46_scoreFinal)) + "\","
    msg += "\"buy_score\":\"" + str.tostring(math.round(buyScore)) + "\","
    msg += "\"sell_score\":\"" + str.tostring(math.round(sellScore)) + "\","
    msg += "\"entry_zone\":\"" + impV46_clean(entryTxt) + "\","
    msg += "\"retro_zone\":\"" + impV46_clean(retroTxt) + "\","
    msg += "\"accion\":\"" + impV46_clean(accionTxt) + "\","
    msg += "\"fase\":\"" + impV46_clean(faseTxt) + "\","
    msg += "\"modo\":\"" + impV46_clean(modoTxt) + "\","
    msg += "\"bias\":\"" + impV46_clean(biasV48) + "\","
    msg += "\"setup\":\"" + impV46_clean(setupV48) + "\","
    msg += "\"trigger\":\"" + impV46_clean(triggerV48) + "\","
    msg += "\"poi\":\"" + impV46_clean(poiTxt) + "\","
    msg += "\"pending_order\":\"" + impV46_clean(pendingOrderTxt) + "\","
    msg += "\"location_quality\":\"" + str.tostring(math.round(locationQuality)) + "\","
    msg += "\"ict_structure\":\"" + impV46_clean(ictStructureTxt) + "\","
    msg += "\"ict_liquidity\":\"" + impV46_clean(ictLiquidityTxt) + "\","
    msg += "\"ict_ote\":\"" + impV46_clean(ictOteTxt) + "\","
    msg += "\"ict_session\":\"" + impV46_clean(ictSessionTxt) + "\","
    msg += "\"ict_buy_quality\":\"" + str.tostring(math.round(ictBuyQuality)) + "\","
    msg += "\"ict_sell_quality\":\"" + str.tostring(math.round(ictSellQuality)) + "\","
    msg += "\"ict_action\":\"" + impV46_clean(ictActionTxt) + "\","
    msg += "\"prev_day_position\":\"" + impV46_clean(prevDayPosTxt) + "\","
    msg += "\"prev_day_raid\":\"" + impV46_clean(prevDayRaidTxt) + "\","
    msg += "\"fractal_bias\":\"" + impV46_clean(fractalBiasTxt) + "\","
    msg += "\"fractal_action\":\"" + impV46_clean(fractalActionTxt) + "\","
    msg += "\"fractal_buy_quality\":\"" + str.tostring(math.round(fractalBuyQuality)) + "\","
    msg += "\"fractal_sell_quality\":\"" + str.tostring(math.round(fractalSellQuality)) + "\","
    msg += "\"risk\":\"" + impV46_clean(executionRisk) + "\""
    msg += "}"
    msg

impV47_preMsg(_side) =>
    string msg = "{"
    msg += "\"source\":\"IMPULXOR_V50_1_PREV_DAY_FRACTAL_PRO\","
    msg += "\"ticker\":\"" + syminfo.ticker + "\","
    msg += "\"symbol\":\"" + syminfo.tickerid + "\","
    msg += "\"tf\":\"" + timeframe.period + "\","
    msg += "\"signal\":\"PRE_" + _side + "\","
    msg += "\"event\":\"PRE_ALERT_" + _side + "\","
    msg += "\"price\":\"" + str.tostring(close, format.mintick) + "\","
    msg += "\"entry_zone\":\"" + impV46_clean(entryTxt) + "\","
    msg += "\"retro_zone\":\"" + impV46_clean(retroTxt) + "\","
    msg += "\"score\":\"" + str.tostring(math.round(impV46_scoreFinal)) + "\","
    msg += "\"buy_score\":\"" + str.tostring(math.round(buyScore)) + "\","
    msg += "\"sell_score\":\"" + str.tostring(math.round(sellScore)) + "\","
    msg += "\"fase\":\"" + impV46_clean(faseTxt) + "\","
    msg += "\"accion\":\"PRE ALERTA: ESPERAR GATILLO / CONFIRMACION\""
    msg += "}"
    msg

// ALERTAS DINÁMICAS PARA USAR EN TRADINGVIEW:
// Condición: IMPULXOR V47.2 -> Cualquier llamada a la función alert()
if impV46_buySignal and not impV46_buySignal[1]
    alert(impV46_msg("BUY"), alert.freq_once_per_bar_close)

if impV46_sellSignal and not impV46_sellSignal[1]
    alert(impV46_msg("SELL"), alert.freq_once_per_bar_close)

if impV47_buyPreAlert and not impV47_buyPreAlert[1]
    alert(impV47_preMsg("BUY"), alert.freq_once_per_bar_close)

if impV47_sellPreAlert and not impV47_sellPreAlert[1]
    alert(impV47_preMsg("SELL"), alert.freq_once_per_bar_close)

impV47_anyTelegramAlert = impV46_buySignal or impV46_sellSignal or impV47_buyPreAlert or impV47_sellPreAlert

alertcondition(impV46_buySignal, title="IMPULXOR V50 BUY VALIDADO", message="BUY IMPULXOR VALIDADO")
alertcondition(impV46_sellSignal, title="IMPULXOR V50 SELL VALIDADO", message="SELL IMPULXOR VALIDADO")
alertcondition(impV47_buyPreAlert, title="IMPULXOR V50 PRE ALERTA BUY", message="PRE ALERTA BUY IMPULXOR: esperando gatillo/confirmacion")
alertcondition(impV47_sellPreAlert, title="IMPULXOR V50 PRE ALERTA SELL", message="PRE ALERTA SELL IMPULXOR: esperando gatillo/confirmacion")
alertcondition(impV47_anyTelegramAlert, title="IMPULXOR V50 TODAS LAS ALERTAS", message="IMPULXOR V50 ALERTA BUY/SELL/PRE")
